# Host-side tools only. Compose Spring apps always use nacos:8848 on the Docker network.
NACOS_ADDR=127.0.0.1:8848
# Nacos namespace ID (create it in the console; not the display name)
NACOS_NS=dev
# Nacos 3.x requires a Base64 token at startup (openssl rand -base64 48). Dev placeholder only.
NACOS_AUTH_TOKEN=TWluaU1hcnREZXZOYWNvc0F1dGhUb2tlbktleTMyQiEh
NACOS_AUTH_IDENTITY_KEY=serverIdentity
NACOS_AUTH_IDENTITY_VALUE=security

# Bare-metal MySQL / Redis on the host. Containers reach them via host.docker.internal.
DB_HOST=host.docker.internal
DB_PORT=3306
DB_USERNAME=minimart
DB_PASSWORD=minimart
REDIS_HOST=host.docker.internal
REDIS_PORT=6379
